.DS_Store
Thumbs.db

.env
.env.*
!.env.example

node_modules/
dist/
.astro/
src/generated/tokens.css
build/
coverage/

*.log

.vscode/
.idea/

# Raw authenticated captures. This repository is public: originals from
# behind a login carry real client data (lead names, revenue figures,
# session identity) and must never be committed. Only the cropped or
# masked derivatives alongside them are safe to publish.
brand-assets/evidence/_raw/

# Vídeo: 1,8 GB de originais de câmera, intermediários e renders. Nada disso
# entra no repositório — só os documentos de processo do primeiro nível.
videos/*
!videos/*.md
!videos/*.txt

# videos/v2/ é o entregável final, não material de trabalho: capas, legenda,
# pacote de SEO e documentação entram; só o .mp4 em si (dezenas de MB) fica
# de fora, no mesmo espírito do resto desta regra.
!videos/v2/
videos/v2/**/*.mp4
