---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Página não encontrada — Leo Ferraz"
  description="Esta página não existe ou foi movida."
  noindex={true}
>
  <SiteHeader links={[{ label: 'Laboratório', href: '/laboratorio/' }, { label: 'Brand System', href: '/brand/' }]} />

  <main id="content" class="shell-width home-shell">
    <div>
      <p class="category-label">404</p>
      <h1>Essa página não existe.</h1>
      <p class="not-found__body">O link pode estar errado, ou a página foi movida.</p>
      <p class="not-found__body"><a href="/">Voltar para a página inicial →</a></p>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .not-found__body {
    margin-top: var(--lf-spacing-inline-standard);
    color: var(--lf-color-text-secondary);
  }
</style>
