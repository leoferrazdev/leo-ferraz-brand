---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { socialLinks } from '../data/social-links';
import '../styles/global.css';

// leoferraz.dev is the single bio link on every platform, so this page has to
// route people onward without scrolling. Primary destination first, rest flat.
const primaryChannel = socialLinks.find((link) => link.primary)!;
const otherChannels = socialLinks.filter((link) => !link.primary);
---

<BaseLayout
  title="Leo Ferraz — Building with AI"
  description="Construindo produtos reais com IA."
>
  <SiteHeader links={[{ label: 'Laboratório', href: '/laboratorio/' }, { label: 'Brand System', href: '/brand/' }]} />

  <main id="content" class="homepage shell-width">
    <section class="homepage__hero" aria-labelledby="home-title">
      <div class="homepage__hero-copy">
        <div class="homepage__author-chip">
          <img src="/profile/leo-ferraz-founder-chip-128.jpg" alt="" width="32" height="32" />
          <span>Leo Ferraz</span>
        </div>
        <p class="category-label">AI-NATIVE PRODUCT LAB</p>
        <h1 id="home-title">Construindo produtos reais com IA.</h1>
        <div class="bio-block">
          <p>SaaS · Apps · Jogos · Experimentos</p>
          <p>Documentando a jornada.</p>
        </div>
      </div>
      <aside class="homepage__hero-note" aria-label="Nota de navegação">
        <p>Sistemas reais construídos com IA, com link para cada um.</p>
        <p><a href="/laboratorio/">Ir para o laboratório →</a></p>
      </aside>
    </section>

    <section class="homepage__follow" aria-labelledby="follow-title">
      <div class="homepage__section-heading">
        <div>
          <p class="eyebrow">ONDE ACOMPANHAR</p>
          <h2 id="follow-title">Escolha por onde seguir.</h2>
        </div>
        <p>leoferraz.dev</p>
      </div>
      <div class="follow-grid">
        <a class="follow-primary" href={primaryChannel.href} target="_blank" rel="me noopener noreferrer">
          <span class="follow-primary__label">{primaryChannel.label}</span>
          <span class="follow-primary__note">{primaryChannel.note}</span>
        </a>
        <nav class="follow-secondary" aria-label="Outras plataformas">
          {otherChannels.map((link) => (
            <a href={link.href} target="_blank" rel="me noopener noreferrer">{link.label}</a>
          ))}
        </nav>
      </div>
    </section>

    <section class="homepage__commitment" aria-labelledby="commitment-title">
      <div class="homepage__section-heading">
        <div>
          <p class="eyebrow">COMO EU TRABALHO</p>
          <h2 id="commitment-title">Construir primeiro. Mostrar a evidência depois.</h2>
        </div>
        <p>Idea → Build → Ship → Measure → Learn → Repeat</p>
      </div>
      <div class="commitment-grid">
        <div class="commitment-block">
          <h3>O que não é</h3>
          <p>Não é curso. Não é mentoria. Não é canal de notícia sobre inteligência artificial.</p>
        </div>
        <div class="commitment-block">
          <h3>O compromisso</h3>
          <p>Se um projeto gerar zero, eu mostro. Se gerar prejuízo, eu mostro. Se gerar um resultado bom, também mostro.</p>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
