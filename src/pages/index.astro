---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import FeaturedConcept from '../components/home/FeaturedConcept.astro';
import ConceptSlot from '../components/home/ConceptSlot.astro';
import { featuredConcept, secondaryConcepts } from '../data/homepage-content';
import '../styles/global.css';
---

<BaseLayout
  title="Leo Ferraz — Building with AI"
  description="Construindo produtos reais com IA."
>
  <SiteHeader linkLabel="Brand System" linkHref="/brand/" />

  <main id="content" class="homepage shell-width">
    <section class="homepage__hero" aria-labelledby="home-title">
      <div class="homepage__hero-copy">
        <p class="category-label">AI-NATIVE PRODUCT LAB</p>
        <h1 id="home-title">Construindo produtos reais com IA.</h1>
        <div class="bio-block">
          <p>SaaS · Apps · Jogos · Experimentos</p>
          <p>Documentando a jornada.</p>
        </div>
        <p class="homepage__content-state">FICTIONAL CONCEPTS · REVIEW ONLY</p>
      </div>
      <aside class="homepage__hero-note" aria-label="Homepage content note">
        <p>Cartão de visita editorial.</p>
        <p>Produtos reais substituirão estes conceitos provisórios.</p>
      </aside>
    </section>

    <section class="homepage__featured" aria-labelledby="featured-title">
      <div class="homepage__section-heading">
        <div>
          <p class="eyebrow">PRODUCT / PROJECT INDEX</p>
          <h2 id="featured-title">Featured concept</h2>
        </div>
        <p>Temporary application content</p>
      </div>
      <FeaturedConcept concept={featuredConcept} />
    </section>

    <section class="homepage__slots" aria-labelledby="slots-title">
      <div class="homepage__section-heading">
        <div>
          <p class="eyebrow">NEXT PROJECTS</p>
          <h2 id="slots-title">The lab will expand here.</h2>
        </div>
        <p>No live destinations yet</p>
      </div>
      <div class="homepage__slot-grid">
        {secondaryConcepts.map((concept) => <ConceptSlot concept={concept} />)}
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
