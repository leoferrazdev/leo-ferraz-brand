---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { socialLinks } from '../data/social-links';
import { clientWork } from '../data/client-work';
import '../styles/global.css';

// leoferraz.dev is the single bio link on every platform, so this page has to
// route people onward without scrolling. Primary destination first, rest flat.
const primaryChannel = socialLinks.find((link) => link.primary)!;
const otherChannels = socialLinks.filter((link) => !link.primary);
---

<BaseLayout
  title="Leo Ferraz — Building with AI"
  description="Construindo produtos reais com IA."
>
  <SiteHeader links={[{ label: 'Laboratório', href: '/laboratorio/' }, { label: 'Brand System', href: '/brand/' }]} />

  <main id="content" class="homepage shell-width">
    <section class="homepage__hero" aria-labelledby="home-title">
      <div class="homepage__hero-copy">
        <div class="homepage__author-chip">
          <img src="/profile/leo-ferraz-founder-chip-128.jpg" alt="" width="32" height="32" />
          <span>Leo Ferraz</span>
        </div>
        <p class="category-label">AI-NATIVE PRODUCT LAB</p>
        <h1 id="home-title">Construindo produtos reais com IA.</h1>
        <div class="bio-block">
          <p>SaaS · Apps · Jogos · Experimentos</p>
          <p>Documentando a jornada.</p>
        </div>
      </div>
      <aside class="homepage__hero-note" aria-label="Nota de navegação">
        <p>Sistemas reais construídos com IA, com link para cada um.</p>
        <p><a href="/laboratorio/">Ir para o laboratório →</a></p>
      </aside>
    </section>

    <section class="homepage__conversion" aria-labelledby="conversion-title">
      <div class="homepage__conversion-layout">
        <div class="homepage__conversion-copy">
          <p class="eyebrow">PRÓXIMO PASSO</p>
          <h2 id="conversion-title">Você já vende, mas trava na produção de conteúdo?</h2>
          <p>
            Estou conversando com fundadores, empresários, criadores e especialistas que já possuem uma oferta e enfrentam um gargalo recorrente de presença ou produção.
          </p>
          <p>
            Descreva o seu gargalo para avaliarmos se uma conversa ou um piloto faz sentido.
          </p>
          <a
            class="homepage__conversion-cta"
            data-pilot-interest
            href="https://wa.me/5551992568861?text=Ol%C3%A1%2C%20Leo.%20Eu%20j%C3%A1%20vendo%20algo%20e%20quero%20descrever%20meu%20gargalo%20de%20presen%C3%A7a%20ou%20produ%C3%A7%C3%A3o%20de%20conte%C3%BAdo."
            target="_blank"
            rel="noopener noreferrer"
          >
            Descrever meu gargalo no WhatsApp →
          </a>
        </div>
        <ol class="homepage__conversion-diagram" aria-label="Próximos passos da conversa">
          <li>
            <span class="homepage__conversion-step">01</span>
            <span class="homepage__conversion-step-label">Oferta existente</span>
          </li>
          <li>
            <span class="homepage__conversion-step">02</span>
            <span class="homepage__conversion-step-label">Gargalo de presença ou produção</span>
          </li>
          <li>
            <span class="homepage__conversion-step">03</span>
            <span class="homepage__conversion-step-label">Conversa inicial</span>
          </li>
        </ol>
      </div>
    </section>

    <section class="homepage__proof" aria-labelledby="proof-title">
      <div class="homepage__section-heading">
        <div>
          <p class="eyebrow">TRABALHO RECENTE</p>
          <h2 id="proof-title">Sistemas em operação.</h2>
        </div>
        <p><a href="/laboratorio/">Ver no laboratório →</a></p>
      </div>
      <div class="proof-strip">
        {clientWork.map((project) => (
          <a class="proof-card" href="/laboratorio/">
            <span class="proof-card__shot">
              <img src={project.thumbnail} alt="" width="960" height="600" loading="lazy" decoding="async" />
            </span>
            <span class="proof-card__client">{project.client}</span>
            <span class="proof-card__scope">{project.scope}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="homepage__follow" aria-labelledby="follow-title">
      <div class="homepage__section-heading">
        <div>
          <p class="eyebrow">ONDE ACOMPANHAR</p>
          <h2 id="follow-title">Escolha por onde seguir.</h2>
        </div>
        <p>leoferraz.dev</p>
      </div>
      <div class="follow-grid">
        <a class="follow-primary" href={primaryChannel.href} target="_blank" rel="me noopener noreferrer">
          <span class="follow-primary__label">{primaryChannel.label}</span>
          <span class="follow-primary__note">{primaryChannel.note}</span>
        </a>
        <nav class="follow-secondary" aria-label="Outras plataformas">
          {otherChannels.map((link) => (
            <a href={link.href} target="_blank" rel="me noopener noreferrer">{link.label}</a>
          ))}
        </nav>
      </div>
    </section>

    <section class="homepage__commitment" aria-labelledby="commitment-title">
      <div class="homepage__section-heading">
        <div>
          <p class="eyebrow">COMO EU TRABALHO</p>
          <h2 id="commitment-title">Construir primeiro. Mostrar a evidência depois.</h2>
        </div>
        <p>Idea → Build → Ship → Measure → Learn → Repeat</p>
      </div>
      <div class="commitment-grid">
        <div class="commitment-block">
          <h3>O que não é</h3>
          <p>Não é curso. Não é mentoria. Não é canal de notícia sobre inteligência artificial.</p>
        </div>
        <div class="commitment-block">
          <h3>O compromisso</h3>
          <p>Se um projeto gerar zero, eu mostro. Se gerar prejuízo, eu mostro. Se gerar um resultado bom, também mostro.</p>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />

  <script>
    const pilotCta = document.querySelector<HTMLAnchorElement>('[data-pilot-interest]');

    pilotCta?.addEventListener('click', () => {
      const gtag = (window as typeof window & {
        gtag?: (...args: unknown[]) => void;
      }).gtag;

      gtag?.('event', 'pilot_interest_click', {
        channel: 'whatsapp',
        location: 'homepage_conversion_block',
        campaign: 'leo_digital_s001',
      });
    });
  </script>
</BaseLayout>
