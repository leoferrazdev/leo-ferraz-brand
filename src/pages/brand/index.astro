---
// Canonical source: brand/*.md
// This page is an executable/public projection of approved decisions.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandContainer from '../../components/brand/BrandContainer.astro';
import BrandSection from '../../components/brand/BrandSection.astro';
import BrandSignature from '../../components/brand/BrandSignature.astro';
import ArtifactFrame from '../../components/brand/ArtifactFrame.astro';
import EvidenceBlock from '../../components/brand/EvidenceBlock.astro';
import Metric from '../../components/brand/Metric.astro';
import StatusLabel from '../../components/brand/StatusLabel.astro';
import BrandStack from '../../components/brand/BrandStack.astro';
import '../../styles/global.css';

const swatches = [
  ['Background', '#0D1117'],
  ['Surface 1', '#151B24'],
  ['Surface 2', '#1D2632'],
  ['Border', '#2A3543'],
  ['Border Strong', '#405064'],
  ['Primary Text', '#F3F6FA'],
  ['Secondary Text', '#B7C2CE'],
  ['Muted Text', '#7F8B99'],
  ['Disabled / Low-emphasis', '#596574'],
  ['Accent', '#4DA3FF'],
  ['Accent Strong', '#86C5FF'],
  ['Accent Subtle', '#0F2E4C'],
  ['Experimental Accent', '#9B8CFF'],
  ['Experimental Subtle', '#252044'],
];

const typographyScale = [
  ['Display', '58px / 500', 'type-display', 'Leo Ferraz'],
  ['H1', '46px / 500', 'type-h1', 'Building with AI'],
  ['H2', '30px / 500', 'type-h2', 'AI-Native Product Lab'],
  ['H3', '21px / 500', 'type-h3', 'Construindo produtos reais com IA.'],
  ['Body Large', '20px / 400', 'type-body-large', 'SaaS · Apps · Jogos · Experimentos'],
  ['Body', '17px / 400', 'type-body', 'Documentando a jornada.'],
  ['Body Small', '14px / 400', 'type-body-small', 'Da ideia ao produto.'],
  ['Metadata', '12px / 500', 'type-metadata', 'PROJECT 003 · BUILDING · VERSION 0.3'],
  ['Label', '11px / 500', 'type-label', 'APPROVED TYPOGRAPHY'],
  ['Code / Mono', '12px / 500', 'type-code', 'commit a91f51 · 1,204 USERS · 18%'],
];
---

<BaseLayout
  title="Living Brandbook — Leo Ferraz"
  description="Decisões aprovadas do sistema de marca Leo Ferraz."
>
  <header class="site-header shell-width">
    <a class="wordmark-text" href="/">Leo Ferraz</a>
    <a class="header-link" href="/">Home</a>
  </header>

  <main id="content" class="shell-width brandbook-shell">
    <section class="brandbook-intro" aria-labelledby="brandbook-title">
      <p class="eyebrow">Living Brandbook</p>
      <h1 id="brandbook-title">Approved foundations</h1>
      <p class="intro-copy">Uma projeção pública das decisões aprovadas do sistema de marca.</p>
    </section>

    <div class="brandbook-grid">
      <section class="brand-section" aria-labelledby="identity-title">
        <p class="section-index">01</p>
        <h2 id="identity-title">Identity</h2>
        <div class="identity-list">
          <p class="identity-master">Leo Ferraz</p>
          <p class="identity-descriptor">Building with AI</p>
          <p class="identity-category">AI-Native Product Lab</p>
        </div>
      </section>

      <section class="brand-section" aria-labelledby="language-title">
        <p class="section-index">02</p>
        <h2 id="language-title">Language</h2>
        <p class="policy-label">Policy</p>
        <p class="policy-copy">Global Brand. Localized Communication.</p>
        <dl class="definition-list">
          <div><dt>Primary content</dt><dd>pt-BR</dd></div>
          <div><dt>Global technical</dt><dd>English</dd></div>
        </dl>
      </section>

      <section class="brand-section" aria-labelledby="type-title">
        <p class="section-index">03</p>
        <h2 id="type-title">Typography</h2>
        <p class="system-label">Product / Editorial</p>
        <div class="type-specimen">
          <p class="type-sans">IBM Plex Sans</p>
          <p class="type-mono">IBM Plex Mono</p>
        </div>
        <div class="typography-scale" aria-label="Approved typography scale">
          {typographyScale.map(([role, value, className, sample]) => (
            <div class="type-level">
              <div class="type-level-meta">
                <span class="type-role">{role}</span>
                <code>{value}</code>
              </div>
              <p class={className}>{sample}</p>
            </div>
          ))}
        </div>
        <div class="typography-details">
          <div>
            <h3>Line Heights</h3>
            <p>Display 1.02 · Headings 1.18 · Body 1.55 · Small 1.40 · Mono 1.34</p>
          </div>
          <div>
            <h3>Tracking</h3>
            <p>Display -0.035em · Labels +0.075em · Metadata +0.040em · Mono +0.010em</p>
          </div>
        </div>
        <p class="open-note">Font delivery: self-hosted at build output.</p>
      </section>

      <section class="brand-section brand-section-wide" aria-labelledby="color-title">
        <p class="section-index">04</p>
        <h2 id="color-title">Color</h2>
        <p class="system-label">Precision / Product</p>
        <div class="swatch-grid">
          {swatches.map(([name, value]) => (
            <div class="swatch-item">
              <span class="swatch" style={`background: ${value}`}></span>
              <span class="swatch-name">{name}</span>
              <code>{value}</code>
            </div>
          ))}
        </div>
        <p class="open-note">Semantic colors and light mode remain not defined.</p>
      </section>

      <section class="brand-section brand-section-wide" aria-labelledby="foundations-title">
        <p class="section-index">05</p>
        <h2 id="foundations-title">Visual Foundations</h2>
        <p class="system-label">Modular / Product</p>
        <div class="foundation-grid">
          <div><h3>Spacing</h3><p>4 · 8 · 12 · 16 · 24 · 32 · 48 · 64</p></div>
          <div><h3>Grid</h3><p>10 columns<br />16px gutter<br />32px outer</p></div>
          <div><h3>Radius</h3><p>0 · 4px · 8px</p></div>
          <div><h3>Borders</h3><p>1px · 2px</p></div>
          <div><h3>Glow</h3><p>off by default</p></div>
        </div>
      </section>

      <section class="brand-section brand-section-wide" aria-labelledby="signature-title">
        <p class="section-index">06</p>
        <h2 id="signature-title">Signature</h2>
        <p class="system-label">Pure / Editorial</p>
        <div class="signature-public-grid">
          <div class="signature-public-primary">
            <p class="signature-public-label">Primary Wordmark</p>
            <p class="signature-wordmark">Leo Ferraz</p>
            <p class="signature-public-spec">IBM Plex Sans · 500 · -0.035em</p>
          </div>
          <div class="signature-public-lockup">
            <p class="signature-public-label">Descriptor Lockup</p>
            <p class="signature-wordmark">Leo Ferraz</p>
            <p class="signature-descriptor">Building with AI</p>
          </div>
          <div class="signature-public-lockup">
            <p class="signature-public-label">Institutional Lockup</p>
            <p class="signature-wordmark">Leo Ferraz</p>
            <p class="signature-descriptor">Building with AI</p>
            <p class="signature-category">AI-Native Product Lab</p>
          </div>
          <div class="signature-public-utility">
            <p class="signature-public-label">Secondary utility mark</p>
            <p class="signature-utility">LF</p>
            <p class="open-note">Plain typographic abbreviation for extremely constrained digital contexts only. It is not the primary signature.</p>
          </div>
        </div>
        <div class="signature-usage-summary">
          <h3>Signature Usage</h3>
          <p>Primary Wordmark minimum: 18px · LF minimum digital box: 16px × 16px</p>
          <p>Clear space: 0.5em · LF clear space: 0.25em minimum · monochrome survival required</p>
        </div>
        <p class="open-note">The name is the identity. The system provides the recognition.</p>
      </section>

      <section class="brand-section brand-section-wide" aria-labelledby="responsive-title">
        <p class="section-index">07</p>
        <h2 id="responsive-title">Responsive System</h2>
        <p class="system-label">Canonical breakpoints</p>
        <div class="responsive-system-grid">
          <div><h3>Small</h3><p>&lt; 768px<br />4 columns<br />16px gutter<br />16px outer</p></div>
          <div><h3>Medium</h3><p>768–1199px<br />6 columns<br />16px gutter<br />24px outer</p></div>
          <div><h3>Large</h3><p>&gt;= 1200px<br />10 columns<br />16px gutter<br />32px outer</p></div>
        </div>
        <p class="open-note">Container: 100% width · 1440px maximum · centered.</p>
      </section>

      <section class="brand-section brand-section-wide" aria-labelledby="semantic-title">
        <p class="section-index">08</p>
        <h2 id="semantic-title">Semantic Colors</h2>
        <p class="system-label">semantic / state only</p>
        <div class="semantic-public-grid">
          <div><span class="semantic-public-swatch semantic-success"></span><strong>Success</strong><code>#79D6A2</code></div>
          <div><span class="semantic-public-swatch semantic-warning"></span><strong>Warning</strong><code>#E7B866</code></div>
          <div><span class="semantic-public-swatch semantic-error"></span><strong>Error</strong><code>#F07F8C</code></div>
          <div><span class="semantic-public-swatch semantic-info"></span><strong>Info</strong><code>#7DD3FC</code></div>
        </div>
        <p class="open-note">Semantic colors communicate state only. They do not replace the Primary Technology Accent.</p>
      </section>

      <section class="brand-section brand-section-wide" aria-labelledby="roles-title">
        <p class="section-index">09</p>
        <h2 id="roles-title">Structural Roles</h2>
        <p class="system-label">pre-token implementation</p>
        <div class="public-role-grid">
          <div><h3>Spacing</h3><p>4 · 8 · 12 · 16 · 24 · 32 · 48 · 64</p><small>4–16 local · 24–32 blocks · 48–64 sections</small></div>
          <div><h3>Radius</h3><p>0 · 4px · 8px</p><small>Pills functional only · maximum 8px</small></div>
          <div><h3>Borders</h3><p>1px #2A3543<br />2px #405064</p><small>Separation and strong structural emphasis</small></div>
          <div><h3>Effects</h3><p>Shadow: none by default<br />Glow: not part of Brand System v1</p><small>Exceptional elevation only · glow deferred</small></div>
        </div>
      </section>

      <section class="brand-section brand-section-wide brand-system-public" aria-labelledby="design-system-title">
        <p class="section-index">10</p>
        <h2 id="design-system-title">Design System</h2>
        <p class="system-label">Executable / token-driven</p>
        <BrandContainer class="brand-system-public-container">
          <BrandSection spacing="standard">
            <div class="brand-system-public-header">
              <BrandSignature variant="institutional" />
              <p>Core components project approved brand decisions into reusable Astro primitives.</p>
            </div>
            <div class="brand-system-public-grid">
              <ArtifactFrame>
                <BrandStack gap="content">
                  <StatusLabel variant="info" label="BUILDING" />
                  <strong>REAL PRODUCT ARTIFACT</strong>
                  <EvidenceBlock state="BUILDING" version="0.3" commit="a91f51" metadata="CANONICAL MOCK" />
                </BrandStack>
              </ArtifactFrame>
              <div class="brand-system-public-evidence">
                <EvidenceBlock state="APPROVED" version="0.1.0" commit="tokens" metadata="MACHINE-READABLE" />
                <div class="brand-system-public-metrics">
                  <Metric value="4–8" label="RADIUS" context="CANONICAL" />
                  <Metric value="10" label="GRID COLUMNS" context="LARGE" />
                  <Metric value="1440" label="CONTAINER MAX" context="PIXELS" />
                </div>
              </div>
            </div>
            <div class="brand-system-public-states" aria-label="Semantic states">
              <StatusLabel variant="neutral" label="NEUTRAL" />
              <StatusLabel variant="success" label="SUCCESS" />
              <StatusLabel variant="warning" label="WARNING" />
              <StatusLabel variant="error" label="ERROR" />
              <StatusLabel variant="info" label="INFO" />
            </div>
          </BrandSection>
        </BrandContainer>
        <p class="open-note">Canonical documentation: <code>brand/*.md</code> · Machine-readable implementation: <code>tokens/tokens.json</code>.</p>
      </section>
    </div>

    <footer class="brandbook-footer">
      <p>Canonical source: <code>brand/*.md</code></p>
      <p>This page is an executable/public projection of approved decisions.</p>
    </footer>
  </main>
</BaseLayout>

<style>
  .brand-system-public-container { background: var(--lf-color-surface-1); }
  .brand-system-public-header { display: grid; gap: var(--lf-spacing-block-content); grid-template-columns: minmax(0, 1fr) minmax(16rem, 1fr); align-items: end; }
  .brand-system-public-header p { margin: 0; color: var(--lf-color-text-secondary); line-height: var(--lf-type-body-line-height); }
  .brand-system-public-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--lf-spacing-block-content); }
  .brand-system-public-grid > * { min-width: 0; }
  .brand-system-public-evidence { display: grid; align-content: start; gap: var(--lf-spacing-block-content); }
  .brand-system-public-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--lf-spacing-inline-standard); }
  .brand-system-public-states { display: flex; flex-wrap: wrap; gap: var(--lf-spacing-inline-compact); }
  @media (max-width: 767px) {
    .brand-system-public-header, .brand-system-public-grid { grid-template-columns: 1fr; }
    .brand-system-public-metrics { grid-template-columns: 1fr; }
  }
</style>
