---
// Canonical source: brand/*.md
// This page is an executable/public projection of approved decisions.
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';

const swatches = [
  ['Background', '#0D1117'],
  ['Surface 1', '#151B24'],
  ['Surface 2', '#1D2632'],
  ['Border', '#2A3543'],
  ['Border Strong', '#405064'],
  ['Primary Text', '#F3F6FA'],
  ['Secondary Text', '#B7C2CE'],
  ['Muted Text', '#7F8B99'],
  ['Disabled / Low-emphasis', '#596574'],
  ['Accent', '#4DA3FF'],
  ['Accent Strong', '#86C5FF'],
  ['Accent Subtle', '#0F2E4C'],
  ['Experimental Accent', '#9B8CFF'],
  ['Experimental Subtle', '#252044'],
];

const typographyScale = [
  ['Display', '58px / 500', 'type-display', 'Leo Ferraz'],
  ['H1', '46px / 500', 'type-h1', 'Building with AI'],
  ['H2', '30px / 500', 'type-h2', 'AI-Native Product Lab'],
  ['H3', '21px / 500', 'type-h3', 'Construindo produtos reais com IA.'],
  ['Body Large', '20px / 400', 'type-body-large', 'SaaS · Apps · Jogos · Experimentos'],
  ['Body', '17px / 400', 'type-body', 'Documentando a jornada.'],
  ['Body Small', '14px / 400', 'type-body-small', 'Da ideia ao produto.'],
  ['Metadata', '12px / 500', 'type-metadata', 'PROJECT 003 · BUILDING · VERSION 0.3'],
  ['Label', '11px / 500', 'type-label', 'APPROVED TYPOGRAPHY'],
  ['Code / Mono', '12px / 500', 'type-code', 'commit a91f51 · 1,204 USERS · 18%'],
];
---

<BaseLayout
  title="Living Brandbook — Leo Ferraz"
  description="Decisões aprovadas do sistema de marca Leo Ferraz."
>
  <header class="site-header shell-width">
    <a class="wordmark-text" href="/">Leo Ferraz</a>
    <a class="header-link" href="/">Home</a>
  </header>

  <main id="content" class="shell-width brandbook-shell">
    <section class="brandbook-intro" aria-labelledby="brandbook-title">
      <p class="eyebrow">Living Brandbook</p>
      <h1 id="brandbook-title">Approved foundations</h1>
      <p class="intro-copy">Uma projeção pública das decisões aprovadas do sistema de marca.</p>
    </section>

    <div class="brandbook-grid">
      <section class="brand-section" aria-labelledby="identity-title">
        <p class="section-index">01</p>
        <h2 id="identity-title">Identity</h2>
        <div class="identity-list">
          <p class="identity-master">Leo Ferraz</p>
          <p class="identity-descriptor">Building with AI</p>
          <p class="identity-category">AI-Native Product Lab</p>
        </div>
      </section>

      <section class="brand-section" aria-labelledby="language-title">
        <p class="section-index">02</p>
        <h2 id="language-title">Language</h2>
        <p class="policy-label">Policy</p>
        <p class="policy-copy">Global Brand. Localized Communication.</p>
        <dl class="definition-list">
          <div><dt>Primary content</dt><dd>pt-BR</dd></div>
          <div><dt>Global technical</dt><dd>English</dd></div>
        </dl>
      </section>

      <section class="brand-section" aria-labelledby="type-title">
        <p class="section-index">03</p>
        <h2 id="type-title">Typography</h2>
        <p class="system-label">Product / Editorial</p>
        <div class="type-specimen">
          <p class="type-sans">IBM Plex Sans</p>
          <p class="type-mono">IBM Plex Mono</p>
        </div>
        <div class="typography-scale" aria-label="Approved typography scale">
          {typographyScale.map(([role, value, className, sample]) => (
            <div class="type-level">
              <div class="type-level-meta">
                <span class="type-role">{role}</span>
                <code>{value}</code>
              </div>
              <p class={className}>{sample}</p>
            </div>
          ))}
        </div>
        <div class="typography-details">
          <div>
            <h3>Line Heights</h3>
            <p>Display 1.02 · Headings 1.18 · Body 1.55 · Small 1.40 · Mono 1.34</p>
          </div>
          <div>
            <h3>Tracking</h3>
            <p>Display -0.035em · Labels +0.075em · Metadata +0.040em · Mono +0.010em</p>
          </div>
        </div>
        <p class="open-note">Font delivery: self-hosted at build output.</p>
      </section>

      <section class="brand-section brand-section-wide" aria-labelledby="color-title">
        <p class="section-index">04</p>
        <h2 id="color-title">Color</h2>
        <p class="system-label">Precision / Product</p>
        <div class="swatch-grid">
          {swatches.map(([name, value]) => (
            <div class="swatch-item">
              <span class="swatch" style={`background: ${value}`}></span>
              <span class="swatch-name">{name}</span>
              <code>{value}</code>
            </div>
          ))}
        </div>
        <p class="open-note">Semantic colors and light mode remain not defined.</p>
      </section>

      <section class="brand-section brand-section-wide" aria-labelledby="foundations-title">
        <p class="section-index">05</p>
        <h2 id="foundations-title">Visual Foundations</h2>
        <p class="system-label">Modular / Product</p>
        <div class="foundation-grid">
          <div><h3>Spacing</h3><p>4 · 8 · 12 · 16 · 24 · 32 · 48 · 64</p></div>
          <div><h3>Grid</h3><p>10 columns<br />16px gutter<br />32px outer</p></div>
          <div><h3>Radius</h3><p>0 · 4px · 8px</p></div>
          <div><h3>Borders</h3><p>1px · 2px</p></div>
          <div><h3>Glow</h3><p>off by default</p></div>
        </div>
      </section>

      <section class="brand-section brand-section-wide" aria-labelledby="signature-title">
        <p class="section-index">06</p>
        <h2 id="signature-title">Signature</h2>
        <p class="system-label">Pure / Editorial</p>
        <div class="signature-public-grid">
          <div class="signature-public-primary">
            <p class="signature-public-label">Primary Wordmark</p>
            <p class="signature-wordmark">Leo Ferraz</p>
            <p class="signature-public-spec">IBM Plex Sans · 500 · -0.035em</p>
          </div>
          <div class="signature-public-lockup">
            <p class="signature-public-label">Descriptor Lockup</p>
            <p class="signature-wordmark">Leo Ferraz</p>
            <p class="signature-descriptor">Building with AI</p>
          </div>
          <div class="signature-public-lockup">
            <p class="signature-public-label">Institutional Lockup</p>
            <p class="signature-wordmark">Leo Ferraz</p>
            <p class="signature-descriptor">Building with AI</p>
            <p class="signature-category">AI-Native Product Lab</p>
          </div>
          <div class="signature-public-utility">
            <p class="signature-public-label">Secondary utility mark</p>
            <p class="signature-utility">LF</p>
            <p class="open-note">Plain typographic abbreviation for extremely constrained digital contexts only. It is not the primary signature.</p>
          </div>
        </div>
        <p class="open-note">The name is the identity. The system provides the recognition.</p>
      </section>
    </div>

    <footer class="brandbook-footer">
      <p>Canonical source: <code>brand/*.md</code></p>
      <p>This page is an executable/public projection of approved decisions.</p>
    </footer>
  </main>
</BaseLayout>
