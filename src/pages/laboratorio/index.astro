---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/site/SiteHeader.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { clientWork } from '../../data/client-work';
import GameCard from '../../components/site/GameCard.astro';
import { gamesInDevelopment } from '../../data/games-in-development';
import '../../styles/global.css';
---

<BaseLayout
  title="Laboratório — Leo Ferraz"
  description="Trabalho real construído com IA, e o que está sendo construído no laboratório."
>
  <SiteHeader links={[{ label: 'Home', href: '/' }, { label: 'Brand System', href: '/brand/' }]} />

  <main id="content" class="homepage shell-width">
    <section class="homepage__hero" aria-labelledby="home-title">
      <div class="homepage__hero-copy">
        <p class="category-label">AI-NATIVE PRODUCT LAB</p>
        <h1 id="home-title">O que está sendo construído.</h1>
      </div>
      <aside class="homepage__hero-note" aria-label="Nota sobre o conteúdo desta página">
        <p>Cada item abaixo é um link para o sistema real.</p>
        <p>O status de cada um está declarado como ele é.</p>
      </aside>
    </section>

    <section class="homepage__products" aria-labelledby="games-title">
      <div class="homepage__section-heading">
        <div>
          <p class="eyebrow">JOGOS EM DESENVOLVIMENTO</p>
          <h2 id="games-title">Produtos próprios em construção.</h2>
        </div>
        <p>Produto próprio · sem link público nesta etapa</p>
      </div>
      <div class="games-in-development">
        {gamesInDevelopment.map((game) => <GameCard game={game} />)}
      </div>
    </section>

    <section class="homepage__products" aria-labelledby="client-work-title">
      <div class="homepage__section-heading">
        <div>
          <p class="eyebrow">TRABALHO COM CLIENTES</p>
          <h2 id="client-work-title">Sistemas construídos com IA.</h2>
        </div>
        <p>Links verificáveis · não são produtos do laboratório</p>
      </div>

      <div class="client-work">
        {clientWork.map((project, index) => (
          <article class="client-work__row" data-reverse={index % 2 === 1 ? '' : null}>
            <figure class="client-work__visual">
              <img src={project.thumbnail} alt={project.thumbnailAlt} width="960" height="600" loading="lazy" decoding="async" />
            </figure>
            <div class="client-work__body">
              <div class="client-work__meta">
                <h3>{project.client}</h3>
                <p>{project.scope}</p>
              </div>
              <ul class="client-work__artifacts">
                {project.artifacts.map((artifact) => (
                  <li>
                    <a href={artifact.href} target="_blank" rel="noopener noreferrer">{artifact.label}</a>
                    <span class="client-work__status" data-status={artifact.status}>{artifact.status}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="homepage__commitment" aria-labelledby="own-products-title">
      <div class="homepage__section-heading">
        <div>
          <p class="eyebrow">PRODUTOS PRÓPRIOS</p>
          <h2 id="own-products-title">Ainda não começaram.</h2>
        </div>
      </div>
      <p class="lab-note">
        O trabalho acima é de cliente: prova de execução, não a tese do laboratório.
        Os produtos próprios — com custo, receita e resultado abertos — começam junto
        com a documentação pública, não antes.
      </p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
