---
import type { HomepageConcept } from '../../data/homepage-content';

interface Props {
  concept: HomepageConcept;
}

const { concept } = Astro.props;
---

<article class="concept-slot" aria-labelledby={`${concept.id}-title`}>
  <div class="concept-slot__header">
    <span>{concept.label}</span>
    <span>{concept.category}</span>
  </div>
  <div class="concept-slot__body">
    <span class="concept-slot__marker" aria-hidden="true"></span>
    <div>
      <p class="concept-slot__status">{concept.status}</p>
      <h3 id={`${concept.id}-title`}>{concept.title}</h3>
      <p>{concept.description}</p>
    </div>
  </div>
  <div class="concept-slot__footer">
    <span>{concept.artifactLabel}</span>
    {concept.evidence.map((item) => <span>{item}</span>)}
  </div>
</article>

<style>
  .concept-slot {
    display: grid;
    gap: var(--lf-spacing-component-standard);
    min-height: 220px;
    padding: var(--lf-spacing-block-content);
    background: var(--lf-color-surface-1);
    border: var(--lf-border-width-standard) solid var(--lf-color-border-default);
  }

  .concept-slot__header,
  .concept-slot__footer,
  .concept-slot__status {
    color: var(--lf-color-text-muted);
    font-family: var(--lf-font-family-mono);
    font-size: var(--lf-type-label-size-large);
    letter-spacing: var(--lf-type-label-tracking);
    text-transform: uppercase;
  }

  .concept-slot__header,
  .concept-slot__footer {
    display: flex;
    justify-content: space-between;
    gap: var(--lf-spacing-inline-standard);
  }

  .concept-slot__header { padding-bottom: var(--lf-spacing-component-standard); border-bottom: var(--lf-border-width-standard) solid var(--lf-color-border-default); }
  .concept-slot__footer { align-self: end; padding-top: var(--lf-spacing-component-standard); border-top: var(--lf-border-width-standard) solid var(--lf-color-border-default); }
  .concept-slot__body { display: flex; align-items: flex-start; gap: var(--lf-spacing-inline-standard); }
  .concept-slot__marker { width: 6px; height: 6px; flex: 0 0 6px; margin-top: 0.45em; background: var(--lf-signature-marker-color); }
  .concept-slot__status { margin-bottom: var(--lf-spacing-inline-compact); color: var(--lf-color-accent-primary); }
  .concept-slot h3 { margin-bottom: var(--lf-spacing-inline-compact); color: var(--lf-color-text-primary); font-size: var(--lf-type-h3-size-large); line-height: var(--lf-type-h3-line-height); }
  .concept-slot p:not(.concept-slot__status) { margin-bottom: 0; color: var(--lf-color-text-secondary); line-height: var(--lf-type-body-line-height); }

  @media (max-width: 767px) {
    .concept-slot { min-height: 0; }
    .concept-slot__header,
    .concept-slot__footer { display: grid; gap: var(--lf-spacing-micro); }
  }
</style>
