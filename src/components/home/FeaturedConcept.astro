---
import ArtifactFrame from '../brand/ArtifactFrame.astro';
import EvidenceBlock from '../brand/EvidenceBlock.astro';
import StatusLabel from '../brand/StatusLabel.astro';
import type { HomepageConcept } from '../../data/homepage-content';

interface Props {
  concept: HomepageConcept;
}

const { concept } = Astro.props;
---

<article class="featured-concept" aria-labelledby={`${concept.id}-title`}>
  <div class="featured-concept__header">
    <div>
      <p class="featured-concept__eyebrow">{concept.label} · {concept.category}</p>
      <h3 id={`${concept.id}-title`}>{concept.title}</h3>
      <p class="featured-concept__description">{concept.description}</p>
    </div>
    <StatusLabel variant="info" label={concept.status} />
  </div>

  <ArtifactFrame class="featured-concept__artifact">
    <div class="mock-artifact" aria-label="Fictional product artifact placeholder">
      <div class="mock-artifact__topline">
        <span>{concept.artifactLabel}</span>
        <span>NO LIVE PRODUCT</span>
      </div>
      <div class="mock-artifact__body">
        <span class="mock-artifact__marker" aria-hidden="true"></span>
        <div>
          <p class="mock-artifact__title">{concept.label}</p>
          {concept.artifactLines.map((line) => <p>{line}</p>)}
        </div>
      </div>
      <div class="mock-artifact__footer">FICTIONAL CONTENT · REPLACE WITH REAL ARTIFACT</div>
    </div>
  </ArtifactFrame>

  <EvidenceBlock metadata="REVIEW ONLY" class="featured-concept__evidence">
    {concept.evidence.map((item) => <span class="featured-concept__evidence-note">{item}</span>)}
  </EvidenceBlock>
</article>

<style>
  .featured-concept {
    display: grid;
    gap: var(--lf-spacing-block-content);
    padding: var(--lf-spacing-block-major);
    background: var(--lf-color-surface-1);
    border: var(--lf-border-width-standard) solid var(--lf-color-border-default);
  }

  .featured-concept__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--lf-spacing-block-content);
  }

  .featured-concept__eyebrow,
  .mock-artifact,
  .featured-concept__evidence {
    font-family: var(--lf-font-family-mono);
  }

  .featured-concept__eyebrow {
    margin-bottom: var(--lf-spacing-inline-standard);
    color: var(--lf-color-accent-primary);
    font-size: var(--lf-type-label-size-large);
    letter-spacing: var(--lf-type-label-tracking);
  }

  .featured-concept h3 {
    max-width: 720px;
    margin-bottom: var(--lf-spacing-inline-standard);
    color: var(--lf-color-text-primary);
    font-size: var(--lf-type-h1-size-large);
    line-height: var(--lf-type-h1-line-height);
  }

  .featured-concept__description {
    max-width: 640px;
    margin-bottom: 0;
    color: var(--lf-color-text-secondary);
    font-size: var(--lf-type-body-large-size-large);
    line-height: var(--lf-type-body-large-line-height);
  }

  .featured-concept__artifact {
    padding: var(--lf-spacing-block-content);
  }

  .mock-artifact {
    display: grid;
    min-height: 260px;
    grid-template-rows: auto 1fr auto;
    background: var(--lf-color-background);
    border: var(--lf-border-width-standard) solid var(--lf-color-border-strong);
    color: var(--lf-color-text-secondary);
  }

  .mock-artifact__topline,
  .mock-artifact__footer {
    display: flex;
    justify-content: space-between;
    gap: var(--lf-spacing-inline-standard);
    padding: var(--lf-spacing-inline-standard);
    color: var(--lf-color-muted, var(--lf-color-text-muted));
    font-size: var(--lf-type-label-size-large);
    letter-spacing: var(--lf-type-label-tracking);
  }

  .mock-artifact__topline { border-bottom: var(--lf-border-width-standard) solid var(--lf-color-border-default); }
  .mock-artifact__footer { border-top: var(--lf-border-width-standard) solid var(--lf-color-border-default); }

  .mock-artifact__body {
    display: flex;
    align-items: flex-start;
    gap: var(--lf-spacing-inline-standard);
    padding: var(--lf-spacing-block-major);
  }

  .mock-artifact__marker {
    width: var(--lf-signature-marker-size);
    height: var(--lf-signature-marker-size);
    flex: 0 0 var(--lf-signature-marker-size);
    margin-top: 0.35em;
    background: var(--lf-signature-marker-color);
  }

  .mock-artifact__title {
    margin-bottom: var(--lf-spacing-component-standard);
    color: var(--lf-color-text-primary);
    font-family: var(--lf-font-family-sans);
    font-size: var(--lf-type-h2-size-large);
    font-weight: var(--lf-type-h2-weight);
    line-height: var(--lf-type-h2-line-height);
  }

  .mock-artifact__body p:not(.mock-artifact__title) {
    margin-bottom: var(--lf-spacing-inline-compact);
    color: var(--lf-color-text-secondary);
    font-size: var(--lf-type-metadata-size-large);
  }

  .featured-concept__evidence {
    align-items: center;
  }

  .featured-concept__evidence-note {
    color: var(--lf-color-text-secondary);
    font-size: var(--lf-type-label-size-large);
    letter-spacing: var(--lf-type-label-tracking);
  }

  @media (max-width: 767px) {
    .featured-concept { padding: var(--lf-spacing-block-content); }
    .featured-concept__header { display: grid; }
    .featured-concept h3 { font-size: var(--lf-type-h2-size-small); }
    .featured-concept__description { font-size: var(--lf-type-body-size-small); }
    .mock-artifact__topline,
    .mock-artifact__footer { display: grid; gap: var(--lf-spacing-micro); }
  }
</style>
