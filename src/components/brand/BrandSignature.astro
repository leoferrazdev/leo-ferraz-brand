---
interface Props {
  variant?: 'wordmark' | 'accent' | 'descriptor' | 'institutional' | 'symbol' | 'utility';
  underline?: boolean;
  class?: string;
}

const { variant = 'wordmark', underline = false, class: className = '' } = Astro.props;
const symbolOnly = variant === 'symbol' || variant === 'utility';
const assetName = symbolOnly
  ? 'leo-ferraz-symbol.svg'
  : variant === 'descriptor'
    ? 'leo-ferraz-building-with-ai.svg'
    : variant === 'institutional'
      ? 'leo-ferraz-institutional.svg'
      : variant === 'accent' || underline
        ? 'leo-ferraz-wordmark-underline.svg'
        : 'leo-ferraz-wordmark.svg';
const assetPath = `/brand-assets/exports/day-1/01-profile/${assetName}`;
const alt = symbolOnly
  ? 'Leo Ferraz — Constructed LF'
  : variant === 'descriptor'
    ? 'Leo Ferraz — Building with AI'
    : variant === 'institutional'
      ? 'Leo Ferraz — Building with AI — AI-Native Product Lab'
      : 'Leo Ferraz';
const classes = ['brand-signature', `brand-signature--${symbolOnly ? 'symbol' : variant}`, className].filter(Boolean).join(' ');
---

<span class={classes} data-variant={symbolOnly ? 'symbol' : variant}>
  <img class="brand-signature__asset" src={assetPath} alt={alt} decoding="async" />
</span>

<style>
  .brand-signature {
    display: inline-block;
    max-width: 100%;
    color: var(--lf-color-text-primary);
    line-height: 0;
  }

  .brand-signature__asset {
    display: block;
    width: min(100%, 410px);
    height: auto;
    max-width: 100%;
  }

  .brand-signature--wordmark .brand-signature__asset,
  .brand-signature--accent .brand-signature__asset {
    width: min(100%, 330px);
  }

  .brand-signature--descriptor .brand-signature__asset {
    width: min(100%, 300px);
  }

  .brand-signature--institutional .brand-signature__asset {
    width: min(100%, 410px);
  }

  .brand-signature--symbol .brand-signature__asset {
    width: 40px;
  }

  .brand-signature--utility .brand-signature__asset {
    width: 32px;
  }

  @media (max-width: 767px) {
    .brand-signature--wordmark .brand-signature__asset,
    .brand-signature--accent .brand-signature__asset,
    .brand-signature--descriptor .brand-signature__asset,
    .brand-signature--institutional .brand-signature__asset {
      width: min(100%, 320px);
    }
  }
</style>
