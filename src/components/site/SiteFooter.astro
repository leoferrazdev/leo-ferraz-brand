---
import BrandSignature from '../brand/BrandSignature.astro';
import { socialLinks } from '../../data/social-links';

interface Props {
  note?: string;
}

const { note = 'Building with AI' } = Astro.props;
---

<footer class="site-footer shell-width">
  <div class="site-footer__row">
    <div class="site-footer__brand">
      <BrandSignature variant="wordmarkOnly" />
      <p>{note}</p>
    </div>
    <div class="site-footer__contact">
      <a href="mailto:leo@leoferraz.dev">leo@leoferraz.dev</a>
      <p class="site-footer__category">AI-Native Product Lab</p>
    </div>
  </div>
  <nav class="site-footer__social" aria-label="Redes sociais">
    {socialLinks.map((link) => (
      <a href={link.href} target="_blank" rel="me noopener noreferrer">{link.label}</a>
    ))}
  </nav>
</footer>

<style>
  .site-footer {
    display: grid;
    gap: var(--lf-spacing-component-standard);
    padding-block: var(--lf-spacing-block-content);
    border-top: var(--lf-border-width-standard) solid var(--lf-color-border-default);
    color: var(--lf-color-text-muted);
    font-family: var(--lf-font-family-mono);
    font-size: var(--lf-type-label-size-large);
  }

  .site-footer__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--lf-spacing-block-content);
  }

  .site-footer__brand { display: flex; align-items: center; gap: var(--lf-spacing-inline-compact); }
  .site-footer p { margin: 0; }

  .site-footer__contact {
    display: grid;
    gap: var(--lf-spacing-micro);
    justify-items: end;
  }

  .site-footer__contact a {
    color: var(--lf-color-text-secondary);
    text-decoration: none;
    border-bottom: var(--lf-border-width-standard) solid var(--lf-color-border-strong);
  }

  .site-footer__contact a:hover,
  .site-footer__contact a:focus-visible {
    color: var(--lf-color-accent-primary);
    border-bottom-color: var(--lf-color-accent-primary);
  }

  @media (max-width: 767px) {
    .site-footer__contact { justify-items: start; }
  }

  /*
   * BrandSignature's wordmarkOnly asset bakes in vertical clear space
   * (SIGNATURE.md) so large that visible glyph ink fills only ~37% of
   * its own canvas height (ink bbox y∈[50.97,101.45] of a 137px-tall
   * canvas). A naive container width of 72px — this file's original
   * fix — left only ~11px of visible ink, illegible next to the 11px
   * footer label text (same defect found and corrected on the header
   * logo, see SiteHeader.astro). 131px keeps ink height around 20px:
   * legible, secondary in weight to the header's ~24px ink (footer is
   * a closing mark, not the primary brand touchpoint).
   */
  .site-footer__brand :global(.brand-signature__asset) {
    width: 131px !important;
  }

  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--lf-spacing-inline-standard) var(--lf-spacing-component-standard);
    padding-top: var(--lf-spacing-component-standard);
    border-top: var(--lf-border-width-standard) solid var(--lf-color-border-default);
  }

  .site-footer__social a {
    color: var(--lf-color-text-muted);
    text-decoration: none;
    letter-spacing: var(--lf-type-label-tracking);
    text-transform: uppercase;
  }

  .site-footer__social a:hover,
  .site-footer__social a:focus-visible {
    color: var(--lf-color-accent-primary);
  }

  @media (max-width: 767px) {
    .site-footer__row { align-items: flex-start; flex-direction: column; gap: var(--lf-spacing-inline-standard); }
  }
</style>
