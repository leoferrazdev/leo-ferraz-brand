---
import BrandSignature from '../brand/BrandSignature.astro';

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  href?: string;
  links?: NavLink[];
}

const { href = '/', links = [] } = Astro.props;
---

<header class="site-header shell-width">
  <a class="site-header__brand" href={href} aria-label="Leo Ferraz — Building with AI">
    <BrandSignature variant="wordmarkOnly" />
  </a>
  {links.length > 0 ? (
    <nav class="site-header__nav" aria-label="Navegação principal">
      {links.map((link) => <a class="header-link" href={link.href}>{link.label}</a>)}
    </nav>
  ) : null}
</header>

<style>
  .site-header__brand {
    display: inline-grid;
    gap: var(--lf-spacing-micro);
    color: var(--lf-color-text-primary);
    text-decoration: none;
  }

  /*
   * BrandSignature's wordmarkOnly variant defaults to hero-lockup scale
   * (min(100%, 330px)) — correct for the homepage hero but next to
   * 12px nav links it dwarfed the header, inflating its height to
   * ~189px. Same fix and same size as the footer wordmark
   * (SiteFooter.astro) to keep brand-mark scale consistent across
   * the two chrome regions.
   */
  .site-header__brand :global(.brand-signature__asset) {
    width: 72px !important;
  }

  .site-header__nav {
    display: flex;
    gap: var(--lf-spacing-block-content);
  }

  @media (max-width: 767px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--lf-spacing-inline-standard);
    }
  }
</style>
