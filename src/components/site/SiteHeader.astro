---
import BrandSignature from '../brand/BrandSignature.astro';

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  href?: string;
  links?: NavLink[];
}

const { href = '/', links = [] } = Astro.props;
---

<header class="site-header shell-width">
  <a class="site-header__brand" href={href} aria-label="Leo Ferraz — Building with AI">
    <BrandSignature variant="wordmarkOnly" />
  </a>
  {links.length > 0 ? (
    <nav class="site-header__nav" aria-label="Navegação principal">
      {links.map((link) => <a class="header-link" href={link.href}>{link.label}</a>)}
    </nav>
  ) : null}
</header>

<style>
  .site-header__brand {
    display: inline-grid;
    gap: var(--lf-spacing-micro);
    color: var(--lf-color-text-primary);
    text-decoration: none;
  }

  /*
   * BrandSignature's wordmarkOnly asset bakes in vertical clear space
   * (SIGNATURE.md): the visible glyph ink fills only ~37% of the SVG's
   * own canvas height. At the hero-lockup default (330px wide) the
   * layout box ballooned to 137px tall, but the ink itself read at a
   * legible ~50px. 72px (matched to the footer) shrank the ink to
   * ~11px — illegible next to nav links. 160px keeps ink height around
   * 24px — legible, clearly the primary mark, still a fraction of the
   * original bloated layout box (~66px vs 137px) and comfortably above
   * the 44px touch-target minimum on its own.
   */
  .site-header__brand :global(.brand-signature__asset) {
    width: 160px !important;
  }

  .site-header__nav {
    display: flex;
    gap: var(--lf-spacing-block-content);
  }

  @media (max-width: 767px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--lf-spacing-inline-standard);
    }
  }
</style>
