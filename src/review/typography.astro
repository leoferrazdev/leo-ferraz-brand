---
import BaseLayout from '../layouts/BaseLayout.astro';

const options = [
  {
    id: 'A',
    name: 'Precision / Dense',
    display: '48px / 600',
    h1: '40px / 600',
    h2: '26px / 600',
    h3: '19px / 600',
    bodyLarge: '18px / 400',
    body: '16px / 400',
    bodySmall: '13px / 400',
    metadata: '11px / 500',
    label: '10px / 500',
    mono: '11px / 500',
    lineHeights: 'display .98 · headings 1.12 · body 1.42 · small 1.32 · mono 1.28',
    tracking: 'display -.045em · labels +.10em · metadata +.06em · mono +.02em',
  },
  {
    id: 'B',
    name: 'Product / Editorial',
    display: '58px / 500',
    h1: '46px / 500',
    h2: '30px / 500',
    h3: '21px / 500',
    bodyLarge: '20px / 400',
    body: '17px / 400',
    bodySmall: '14px / 400',
    metadata: '12px / 500',
    label: '11px / 500',
    mono: '12px / 500',
    lineHeights: 'display 1.02 · headings 1.18 · body 1.55 · small 1.40 · mono 1.34',
    tracking: 'display -0.035em · labels +0.075em · metadata +0.040em · mono +0.010em',
  },
  {
    id: 'C',
    name: 'Display / Spatial',
    display: '70px / 500',
    h1: '54px / 500',
    h2: '34px / 500',
    h3: '22px / 500',
    bodyLarge: '20px / 400',
    body: '18px / 400',
    bodySmall: '14px / 400',
    metadata: '12px / 500',
    label: '11px / 500',
    mono: '13px / 500',
    lineHeights: 'display .95 · headings 1.14 · body 1.64 · small 1.45 · mono 1.28',
    tracking: 'display -.055em · labels +.11em · metadata +.05em · mono +.015em',
  },
];

const roles = [
  ['display', 'display'],
  ['h1', 'h1'],
  ['h2', 'h2'],
  ['h3', 'h3'],
  ['body-large', 'bodyLarge'],
  ['body', 'body'],
  ['body-small', 'bodySmall'],
  ['metadata', 'metadata'],
  ['label', 'label'],
  ['code / mono', 'mono'],
];
---

<BaseLayout
  title="Typography Review — Leo Ferraz"
  description="Temporary, non-canonical comparison of typography implementation candidates."
>
  <main class="review-page" id="content">
    <header class="review-header">
      <p class="review-kicker">TYPOGRAPHY REVIEW</p>
      <h1>Three candidate systems for the same brand voice.</h1>
      <p class="review-intro">TEMPORARY VISUAL COMPANION · NOT CANONICAL · CANDIDATE VALUES · NO FINAL DESIGN TOKENS</p>
      <div class="review-conditions" aria-label="Shared conditions">
        <span>Families <b>IBM Plex Sans + IBM Plex Mono</b></span>
        <span>Color <b>Precision / Product</b></span>
        <span>Foundations <b>Modular / Product</b></span>
      </div>
    </header>

    <section class="options-grid" aria-label="Typography options">
      {options.map((option) => (
        <article class={`option option-${option.id.toLowerCase()}`} aria-labelledby={`option-${option.id}`}>
          <header class="option-header">
            <p class="mono label">OPTION {option.id}</p>
            <h2 id={`option-${option.id}`}>{option.name}</h2>
            <p class="mono muted">same content · review-only values</p>
          </header>

          <section class="specimen hero-specimen">
            <p class="mono label">BRAND / DISPLAY</p>
            <p class="display">Leo Ferraz</p>
            <p class="descriptor">Building with AI</p>
            <p class="mono metadata">AI-Native Product Lab</p>
          </section>

          <section class="specimen editorial-specimen">
            <p class="mono label">EDITORIAL</p>
            <h3>CONSTRUINDO PRODUTOS REAIS COM IA.</h3>
            <p class="body-large">SaaS · Apps · Jogos · Experimentos</p>
            <p class="body">Documentando a jornada.</p>
          </section>

          <section class="specimen artifact-specimen">
            <p class="mono label">ARTIFACT</p>
            <div class="artifact-frame"><span>REAL PRODUCT ARTIFACT</span></div>
            <p class="mono metadata">MOCK CONTENT</p>
          </section>

          <section class="specimen evidence-specimen">
            <p class="mono label">EVIDENCE · MOCK DATA</p>
            <div class="evidence-heading"><strong>PROJECT 003</strong><span>BUILDING</span><span>VERSION 0.3</span></div>
            <div class="metrics"><strong>1,204 USERS</strong><strong>30 DAYS</strong><strong>18%</strong><code>commit a91f51</code></div>
          </section>

          <section class="specimen density-specimen">
            <p class="mono label">DENSITY CANDIDATES</p>
            <div class="density-row"><span class="mono">LOW</span><span>Leo Ferraz · Building with AI</span></div>
            <div class="density-row"><span class="mono">MEDIUM</span><span>Product · Evidence · Artifact</span></div>
            <div class="density-row dense"><span class="mono">HIGH</span><span>PROJECT 003 / BUILDING / 18% / commit a91f51</span></div>
          </section>

          <section class="values" aria-label={`Candidate values for ${option.name}`}>
            <p class="mono label">CANDIDATE VALUES</p>
            <dl>
              {roles.map(([role, key]) => <div><dt>{role}</dt><dd>{option[key]}</dd></div>)}
            </dl>
            <p class="mono value-note">line-height · {option.lineHeights}</p>
            <p class="mono value-note">tracking · {option.tracking}</p>
          </section>
        </article>
      ))}
    </section>

    <footer class="review-footer">
      <p class="mono">DECISION IS DOCUMENTARY · SPECIMEN REMAINS NEUTRAL</p>
      <p class="mono">TEMPORARY FONT LOADING: ASTRO FONTS API + LOCAL NPM PACKAGES · REMOTE FALLBACK DISABLED · NOT PERSISTED AS TOKENS</p>
    </footer>
  </main>
</BaseLayout>

<style>
  :global(:root) {
    --review-bg: #0D1117;
    --review-surface: #151B24;
    --review-surface-2: #1D2632;
    --review-border: #2A3543;
    --review-border-strong: #405064;
    --review-text: #F3F6FA;
    --review-secondary: #B7C2CE;
    --review-muted: #7F8B99;
    --review-accent: #4DA3FF;
    --review-accent-strong: #86C5FF;
    --review-violet: #9B8CFF;
  }

  :global(html) { background: var(--review-bg); color: var(--review-text); font-family: var(--font-ibm-plex-sans), sans-serif; }
  :global(body) { min-width: 320px; margin: 0; background: var(--review-bg); color: var(--review-text); }
  :global(a) { color: var(--review-accent); }
  :global(.skip-link) { position: absolute; left: 12px; top: 12px; }
  :global(.mono), :global(code) { font-family: var(--font-ibm-plex-mono), monospace; }

  .review-page { width: min(100% - 48px, 1500px); margin: 0 auto; padding: 48px 0 64px; }
  .review-header { max-width: 920px; padding-bottom: 32px; border-bottom: 1px solid var(--review-border); }
  .review-kicker, .label { margin: 0 0 12px; color: var(--review-accent); letter-spacing: .11em; font-size: 11px; font-weight: 500; }
  .review-header h1 { max-width: 740px; margin: 0 0 20px; font-size: clamp(2.4rem, 5vw, 4.3rem); font-weight: 500; letter-spacing: -.035em; line-height: 1.02; }
  .review-intro { margin: 0 0 24px; color: var(--review-secondary); line-height: 1.55; }
  .review-conditions { display: flex; flex-wrap: wrap; gap: 8px 24px; color: var(--review-muted); }
  .review-conditions span { display: grid; gap: 4px; font-family: var(--font-ibm-plex-mono), monospace; font-size: 12px; }
  .review-conditions b { color: var(--review-text); font-weight: 500; }
  .options-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding-top: 32px; }
  .option { min-width: 0; overflow: hidden; background: var(--review-surface); border: 1px solid var(--review-border); }
  .option-header, .specimen, .values { padding: 24px; }
  .option-header { min-height: 126px; border-bottom: 1px solid var(--review-border); }
  .option-header h2 { margin: 0 0 8px; font-size: 1.5rem; font-weight: 500; letter-spacing: -.02em; }
  .muted { margin: 0; color: var(--review-muted); font-size: 11px; }
  .specimen { border-bottom: 1px solid var(--review-border); }
  .hero-specimen { min-height: 240px; }
  .display { margin: 34px 0 12px; font-size: var(--display-size); font-weight: var(--display-weight); letter-spacing: var(--display-tracking); line-height: var(--display-leading); }
  .descriptor { margin: 0 0 26px; color: var(--review-secondary); font-size: var(--h3-size); font-weight: var(--h3-weight); line-height: var(--heading-leading); }
  .metadata { margin: 0; color: var(--review-muted); font-size: var(--metadata-size); font-weight: var(--metadata-weight); letter-spacing: var(--metadata-tracking); }
  .editorial-specimen h3 { margin: 30px 0 18px; font-size: var(--h2-size); font-weight: var(--h2-weight); line-height: var(--heading-leading); }
  .body-large { margin: 0 0 8px; color: var(--review-secondary); font-size: var(--body-large-size); font-weight: 400; line-height: var(--body-leading); }
  .body { margin: 0; color: var(--review-secondary); font-size: var(--body-size); font-weight: 400; line-height: var(--body-leading); }
  .artifact-frame { display: grid; place-items: center; min-height: 150px; margin: 28px 0 12px; background: var(--review-surface-2); border: 1px solid var(--review-border-strong); color: var(--review-muted); font-family: var(--font-ibm-plex-mono), monospace; font-size: var(--body-small-size); letter-spacing: .06em; }
  .evidence-heading, .metrics { display: grid; gap: 10px; margin-top: 28px; color: var(--review-secondary); font-family: var(--font-ibm-plex-mono), monospace; font-size: var(--metadata-size); line-height: var(--mono-leading); }
  .evidence-heading strong, .metrics strong { color: var(--review-text); font-weight: 500; }
  .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 24px; }
  .metrics code { grid-column: 1 / -1; color: var(--review-accent); font-size: var(--mono-size); }
  .density-row { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--review-border); color: var(--review-secondary); font-size: var(--body-small-size); line-height: var(--small-leading); }
  .density-row:last-child { border-bottom: 0; }
  .density-row .mono { color: var(--review-violet); font-size: var(--label-size); letter-spacing: var(--label-tracking); }
  .values { background: #111720; }
  .values dl { margin: 24px 0; }
  .values dl div { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--review-border); }
  .values dt, .values dd { margin: 0; font-family: var(--font-ibm-plex-mono), monospace; font-size: var(--metadata-size); }
  .values dt { color: var(--review-muted); }
  .values dd { color: var(--review-text); text-align: right; }
  .value-note { margin: 8px 0 0; color: var(--review-muted); font-size: 10px; line-height: 1.45; }
  .review-footer { display: grid; gap: 8px; padding-top: 24px; color: var(--review-muted); font-size: 10px; line-height: 1.45; }
  .review-footer p { margin: 0; }

  .option-a { --display-size: 48px; --display-weight: 600; --h2-size: 26px; --h2-weight: 600; --h3-size: 19px; --h3-weight: 600; --body-large-size: 18px; --body-size: 16px; --body-small-size: 13px; --metadata-size: 11px; --metadata-weight: 500; --label-size: 10px; --mono-size: 11px; --display-leading: .98; --heading-leading: 1.12; --body-leading: 1.42; --small-leading: 1.32; --mono-leading: 1.28; --display-tracking: -.045em; --label-tracking: .10em; --metadata-tracking: .06em; }
  .option-b { --display-size: 58px; --display-weight: 500; --h2-size: 30px; --h2-weight: 500; --h3-size: 21px; --h3-weight: 500; --body-large-size: 20px; --body-size: 17px; --body-small-size: 14px; --metadata-size: 12px; --metadata-weight: 500; --label-size: 11px; --mono-size: 12px; --display-leading: 1.02; --heading-leading: 1.18; --body-leading: 1.55; --small-leading: 1.40; --mono-leading: 1.34; --display-tracking: -.035em; --label-tracking: .075em; --metadata-tracking: .040em; }
  .option-c { --display-size: 70px; --display-weight: 500; --h2-size: 34px; --h2-weight: 500; --h3-size: 22px; --h3-weight: 500; --body-large-size: 20px; --body-size: 18px; --body-small-size: 14px; --metadata-size: 12px; --metadata-weight: 500; --label-size: 11px; --mono-size: 13px; --display-leading: .95; --heading-leading: 1.14; --body-leading: 1.64; --small-leading: 1.45; --mono-leading: 1.28; --display-tracking: -.055em; --label-tracking: .11em; --metadata-tracking: .05em; }

  @media (max-width: 1100px) {
    .options-grid { grid-template-columns: 1fr; }
    .option { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .option-header, .values { grid-column: 1 / -1; }
  }
  @media (max-width: 680px) {
    .review-page { width: min(100% - 32px, 1500px); padding-top: 32px; }
    .option { display: block; }
    .option-header, .specimen, .values { padding: 20px; }
    .display { font-size: min(var(--display-size), 15vw); }
    .metrics { grid-template-columns: 1fr 1fr; }
  }
</style>
