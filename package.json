{
  "name": "leo-ferraz-brand",
  "private": true,
  "type": "module",
  "scripts": {
    "brand-assets:build": "node scripts/build-brand-assets.mjs",
    "brand-assets:validate": "node scripts/validate-brand-assets.mjs",
    "founder-avatar:build": "node scripts/build-founder-avatar.mjs",
    "founder-avatar:test": "node --test tests/founder-avatar.test.mjs",
    "brand:render": "node scripts/render-brand-content.mjs",
    "live-covers:build": "node scripts/build-live-covers.mjs",
    "video-cover-pack:build": "node scripts/build-video-cover-pack.mjs",
    "video-cover-pack:test": "node --test tests/video-cover-pack.test.mjs",
    "video-cover:build": "node scripts/build-video-cover.mjs",
    "thumbnail:build": "node scripts/build-thumbnail-v2.mjs",
    "video:check": "node scripts/check-video-quality.mjs",
    "tokens:validate": "node scripts/validate-tokens.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens:validate && npm run tokens:build && npm run brand-assets:build && astro dev",
    "build": "npm run tokens:validate && npm run tokens:build && npm run brand-assets:build && astro build",
    "preview": "astro preview"
  },
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "devDependencies": {
    "astro": "7.2.2",
    "fontkitten": "1.0.3",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0"
  }
}
